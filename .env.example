APP_BASE_URL=http://localhost:3000
# Comma-separated list of emails allowed to access /admin
ADMIN_EMAILS=you@yourdomain.com

NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

STRIPE_PLATFORM_SECRET_KEY=sk_test_...
# Platform events (subscriptions) -> /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Connected-account events (guest deposits) -> /api/stripe/connect-webhook
# Production: separate endpoint in Stripe = separate secret.
# Local `stripe listen` uses ONE secret for both, so leave this empty locally
# (falls back to STRIPE_WEBHOOK_SECRET).
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SUB_PRICE_ID=price_...

PLATFORM_BRAND_NAME=Deposit Links
DEFAULT_VENDOR_COUNTRY=ES
